{
  "name": "tommys-swe-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build --force && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run validate && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
