---
import { getCollection, getEntry } from 'astro:content';
import { version } from '../../package.json';
import Duck from '../components/brand/Duck.astro';
import PondScene from '../components/brand/PondScene.astro';
import Fonts from '../components/Fonts.astro';
import '../styles/tokens.css';
import '../styles/landing.css';

const docs = await getCollection('docs');
const concerns = docs.filter(
  (d) => d.id.startsWith('concerns/') && d.id !== 'concerns',
);
const trackStops = docs.filter((d) => d.data.track).length;
const repo = 'https://github.com/devduck123/swe-os';
const title =
  "Tommy's SWE OS: engineering judgment for people and their agents";
const description =
  'A slightly opinionated guide to building and designing software, written for two readers: people learning what a vibe coder forgets to ask for, and the coding agents that build with them.';
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).href;

// A few of the things people miss, pulled from the stops themselves so they never drift.
const picks = [
  'vibe-coder-vs-engineer',
  'trust-boundaries',
  'timeouts-retries-idempotency',
  'shipping-changes-you-can-undo',
  'knowing-it-broke',
];
const misses = await Promise.all(
  picks.map(async (id) => {
    const entry = (await getEntry('docs', `guides/${id}`))!;
    const lead = entry.body!.match(/^- \*\*(.+?)\*\*/m)?.[1];
    if (!lead) throw new Error(`guides/${id} has no "Easy to miss" bullet`);
    return {
      lead,
      title: entry.data.title,
      track: entry.data.track,
      href: `/guides/${id}/`,
    };
  }),
);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {Astro.site && <link rel="canonical" href={Astro.site.href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tommy's SWE OS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={Astro.site.href} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Tommy's SWE OS" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fonts display />
    <script is:inline>
      // Share the theme choice with the docs pages, which use the same storage key.
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>

    <header class="nav">
      <a class="brand" href="/">
        <Duck size={28} />
        <span class="brand__name">
          <span class="sr-only">Tommy's </span>swe <em>os</em>
        </span>
      </a>
      <nav aria-label="Main">
        <ul class="nav__links">
          <li>
            <a href="/guides/">The track</a>
          </li>
          <li>
            <a href="/principles/">Principles</a>
          </li>
          <li class="nav__hide-sm">
            <a href="/concerns/">Standards</a>
          </li>
          <li class="nav__hide-sm">
            <a href="/skills/">Skills</a>
          </li>
        </ul>
      </nav>
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch color theme"
      >
        <svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path>
        </svg>
        <svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7.5 7.5 0 1 0 20 14.5Z"></path>
        </svg>
      </button>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <PondScene />
        <div class="hero__copy">
          <p class="eyebrow">
            <span class="dot" aria-hidden="true"></span>For people and their
            coding agents
          </p>
          <h1 id="hero-title">
            AI keeps getting better at code. Shipping it well is still the{' '}
            <span class="mark">
              hard part.
              <svg
                class="mark__line"
                viewBox="0 0 200 16"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  pathLength="1"
                  d="M4 10c40-6 92-8 140-5 18 1 34 3 52 1M30 13c40-3 84-4 120-2"
                ></path>
              </svg>
            </span>
          </h1>
          <p class="lede">
            SWE OS is a slightly opinionated guide to building and designing
            software, written for two readers. <strong>People</strong> read it
            to learn what a vibe coder forgets to ask for.{' '}
            <strong>Coding agents</strong> read the same pages as their
            reference while they build.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href="/guides/">
              Start the track <span aria-hidden="true">→</span>
            </a>
            <a class="btn" href="#agent">
              Point your agent here
            </a>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="misses-title">
        <div class="section__head">
          <p class="eyebrow">From the track</p>
          <h2 id="misses-title">The parts the happy path hides.</h2>
          <p class="section__lede">
            {trackStops} short stops, each one the things people and their
            agents tend to miss. No lesson plans, no code. Just what to watch
            for, and what to ask your agent.
          </p>
        </div>
        <ol class="rows">
          {misses.map((m) => (
            <li>
              <a class="row" href={m.href}>
                <span class="row__num">{String(m.track).padStart(2, '0')}</span>
                <span class="row__main">
                  <span class="row__lead">{m.lead}</span>
                  <span class="row__from">{m.title}</span>
                </span>
                <span class="row__go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="more">
          <a href="/guides/">
            All {trackStops} stops <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>

      <div class="band">
        <svg
          class="band__shore"
          viewBox="0 0 1200 24"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M0 24V12c90-8 170 6 260 2s160-12 250-6 170 10 260 4 170-10 250-4 120 6 180 2v14Z"></path>
        </svg>
        <section class="section agent" id="agent" aria-labelledby="agent-title">
          <div class="section__head">
            <p class="eyebrow">For your agent</p>
            <h2 id="agent-title">Point your agent here.</h2>
            <p class="section__lede">
              Nothing to install. Your agent reads the same pages you do.
            </p>
          </div>
          <div class="agent__grid">
            <ol class="steps">
              <li>
                <strong>You ask, like normal.</strong>
                <span>
                  "Add avatar uploads." No special syntax. It picks the skill
                  that fits.
                </span>
              </li>
              <li>
                <strong>It checks what could go wrong.</strong>
                <span>
                  Against {concerns.length} risks, from auth to cost, and keeps
                  the few that apply.
                </span>
              </li>
              <li>
                <strong>It shows its work.</strong>
                <span>
                  What it ran and what it saw, plus only what's still open. Then
                  one thing worth learning.
                </span>
              </li>
            </ol>
            <div class="card">
              <Duck size={64} alive class="card__duck" />
              <div
                class="tabs"
                role="tablist"
                aria-label="Ways to point your agent here"
              >
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  id="tab-quick"
                  aria-controls="panel-quick"
                  aria-selected="true"
                >
                  Quick
                </button>
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  id="tab-local"
                  aria-controls="panel-local"
                  aria-selected="false"
                  tabindex="-1"
                >
                  Local copy
                </button>
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  id="tab-plugin"
                  aria-controls="panel-plugin"
                  aria-selected="false"
                  tabindex="-1"
                >
                  Claude Code
                </button>
              </div>
              <div
                class="panel"
                role="tabpanel"
                id="panel-quick"
                aria-labelledby="tab-quick"
              >
                <p class="hint">
                  Paste this into your agent. It reads from this site.
                </p>
                <div class="prompt">
                  <code data-prompt>
                    Use Tommy's SWE OS for this task. Download{' '}
                    <span data-origin>/skills/README.md</span> as raw text with
                    curl, follow the skill that fits, and fetch each file it
                    links the same way.
                  </code>
                  <button
                    type="button"
                    class="btn btn--small"
                    data-copy
                    aria-label="Copy the quick prompt"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <div
                class="panel"
                role="tabpanel"
                id="panel-local"
                aria-labelledby="tab-local"
                hidden
              >
                <p class="hint">
                  The best way. Exact text, works offline and in sandboxes
                  without network access. Clone it once, and{' '}
                  <code>git pull</code> now and then.
                </p>
                <div class="prompt">
                  <code data-prompt>git clone {repo} ~/swe-os</code>
                  <button
                    type="button"
                    class="btn btn--small"
                    data-copy
                    aria-label="Copy the clone command"
                  >
                    Copy
                  </button>
                </div>
                <div class="prompt">
                  <code data-prompt>
                    Use Tommy's SWE OS at ~/swe-os for this task. Start at
                    skills/README.md and follow the skill that fits.
                  </code>
                  <button
                    type="button"
                    class="btn btn--small"
                    data-copy
                    aria-label="Copy the local prompt"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <div
                class="panel"
                role="tabpanel"
                id="panel-plugin"
                aria-labelledby="tab-plugin"
                hidden
              >
                <p class="hint">
                  Install the plugin and the skills trigger on their own. Run
                  these in Claude Code, one at a time.
                </p>
                <div class="prompt">
                  <code data-prompt>
                    /plugin marketplace add devduck123/swe-os
                  </code>
                  <button
                    type="button"
                    class="btn btn--small"
                    data-copy
                    aria-label="Copy the marketplace command"
                  >
                    Copy
                  </button>
                </div>
                <div class="prompt">
                  <code data-prompt>/plugin install swe-os@swe-os</code>
                  <button
                    type="button"
                    class="btn btn--small"
                    data-copy
                    aria-label="Copy the install command"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <p class="status" role="status" data-copy-status></p>
              <p class="hint hint--last">
                Agents can also read the whole index at{' '}
                <a href="/llms.txt">
                  <code>/llms.txt</code>
                </a>
                .
              </p>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer class="footer">
      <Duck size={22} />
      <p>
        v{version}. Writing under{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
        code under MIT. <a href={repo}>Source on GitHub</a>.
      </p>
    </footer>

    <script>
      import { setupLanding } from '../scripts/landing';
      setupLanding();
    </script>
  </body>
</html>
