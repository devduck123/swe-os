---
// The SWE OS duck: a plush duck in a graduation cap, drawn as a die-cut sticker (see
// docs/brand.md). Decorative everywhere it appears: the name next to it, or the page around
// it, says what it is. The sticker edge is a filter traced from the duck's own shape, so a
// moving arm takes its edge with it.
//
// With `alive`, it waves once on load and reacts to the reader: eyes follow the pointer, a
// tap or `duck--hop` makes it hop, and its cap tips when the theme changes. Under reduced
// motion it stays still. A `pose` gives it something to hold, for the track's stages.
export type Pose =
  | 'stand'
  | 'read'
  | 'sketch'
  | 'build'
  | 'inspect'
  | 'ship'
  | 'lantern'
  | 'grow'
  | 'diploma';
interface Props {
  size?: number;
  class?: string;
  alive?: boolean;
  pose?: Pose;
}
const {
  size = 32,
  class: className,
  alive = false,
  pose = 'stand',
} = Astro.props;
// How each pose holds its arms (degrees from hanging) and where it looks.
const poses: Record<
  Pose,
  { left: number; right: number; look: [number, number]; happy?: boolean }
> = {
  stand: { left: 0, right: 0, look: [0, 0] },
  read: { left: -30, right: 30, look: [0, 1.8] },
  sketch: { left: -30, right: 20, look: [-1.5, 1.6] },
  build: { left: 8, right: -110, look: [1.5, -1] },
  inspect: { left: 4, right: -30, look: [2.4, 0.6] },
  ship: { left: -30, right: 30, look: [0, 1.6] },
  lantern: { left: 4, right: -30, look: [1.5, 0.8] },
  grow: { left: -30, right: 30, look: [0, 1.6] },
  diploma: { left: -15, right: -118, look: [0, 0], happy: true },
};
const held = poses[pose];
const paper = '#fffdf6';
const coral = '#e8833a';
// A page can show several ducks, so each one gets its own ids for its clip paths and filter.
const id = `duck-${Math.random().toString(36).slice(2, 8)}`;
const line = 'oklch(0.3 0.04 55)';
const yellow = 'oklch(0.93 0.1 97)';
const shade = 'oklch(0.87 0.115 88)';
const orange = 'oklch(0.76 0.15 50)';
const navy = 'oklch(0.27 0.035 268)';
const body = 'M60 74c16 0 28 11 28 26s-12 25-28 25-28-10-28-25 12-26 28-26Z';
// Each arm hangs from a round shoulder tucked under the head, so it can swing all the way up.
const armR =
  'M78 68C86 64 94 70 97 84c2 10 3 20 0 25-3 5-10 4-11-3-1-8-2-16-6-24-3-5-7-11-2-14Z';
const armL =
  'M42 68C34 64 26 70 23 84c-2 10-3 20 0 25 3 5 10 4 11-3 1-8 2-16 6-24 3-5 7-11 2-14Z';
const board = 'M31 21l29-11 29 11-29 11Z';
const skull = 'M42 25c2 8 34 8 36 0v6c-3 8-33 8-36 0Z';
---

<svg
  class:list={['duck', className, { 'duck--alive duck--wave': alive }]}
  width={size}
  height={Math.round((size * 140) / 104)}
  viewBox="8 0 104 140"
  style={
    pose === 'stand'
      ? undefined
      : `--look-x:${held.look[0]}px;--look-y:${held.look[1]}px`
  }
  data-pose={pose === 'stand' ? undefined : pose}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={`${id}-body`}>
      <path d={body}></path>
    </clipPath>
    <clipPath id={`${id}-head`}>
      <ellipse cx="60" cy="52" rx="35" ry="29"></ellipse>
    </clipPath>
    <filter
      id={`${id}-sticker`}
      x="-30%"
      y="-30%"
      width="160%"
      height="160%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur
        in="SourceAlpha"
        stdDeviation="3.4"
        result="blur"
      ></feGaussianBlur>
      <feComponentTransfer in="blur" result="cut">
        <feFuncA type="linear" slope="14" intercept="-1.4"></feFuncA>
      </feComponentTransfer>
      <feFlood flood-color="#fffdf6"></feFlood>
      <feComposite in2="cut" operator="in" result="edge"></feComposite>
      <feGaussianBlur in="cut" stdDeviation="1.6"></feGaussianBlur>
      <feOffset dy="1.8" result="drop"></feOffset>
      <feFlood flood-color="rgb(18 21 31)" flood-opacity="0.22"></feFlood>
      <feComposite in2="drop" operator="in" result="shadow"></feComposite>
      <feMerge>
        <feMergeNode in="shadow"></feMergeNode>
        <feMergeNode in="edge"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  <g filter={`url(#${id}-sticker)`}>
    <!-- Every moving part is wrapped as translate(pivot) > animated group > translate(-pivot),
         so CSS can turn it around its joint with no transform-origin math. -->
    <g transform="translate(60 128)">
      <g class="duck__rig">
        <g transform="translate(-60 -128)">
          <g fill={orange} stroke={line} stroke-width="2">
            <ellipse cx="47" cy="124" rx="8" ry="4.6"></ellipse>
            <ellipse cx="73" cy="124" rx="8" ry="4.6"></ellipse>
          </g>
          <path d={body} fill={yellow}></path>
          <g clip-path={`url(#${id}-body)`}>
            <ellipse cx="74" cy="122" rx="34" ry="18" fill={shade}></ellipse>
            <ellipse
              cx="60"
              cy="104"
              rx="13"
              ry="15"
              fill="oklch(0.96 0.06 98)"
            ></ellipse>
          </g>
          <path d={body} fill="none" stroke={line} stroke-width="2.4"></path>
          {/* Things gripped by a handle sit behind the hand. */}
          {pose === 'build' && (
            <g
              stroke={line}
              stroke-linejoin="round"
              transform="rotate(10 112 50)"
            >
              <rect
                x="109"
                y="27"
                width="7"
                height="34"
                rx="3.5"
                fill="#a9b1c2"
                stroke-width="1.8"
              />
              <path
                d="M104 24c-2-8 3-15 10-15l-3 6 3 5 6-1 3-6c4 6 1 15-6 17-5 2-11-1-13-6Z"
                fill="#a9b1c2"
                stroke-width="1.8"
              />
            </g>
          )}
          {pose === 'lantern' && (
            <g stroke={line} stroke-linejoin="round">
              <path d="M104 100c0-5 9-5 9 0" fill="none" stroke-width="1.8" />
              <path d="M102 102h13l-2 4h-9Z" fill={navy} stroke-width="1.6" />
              <path
                d="M103.5 106h10l-1 13h-8Z"
                fill="#fde7a8"
                stroke-width="1.6"
              />
              <path
                d="M108.5 109c2 2 2 5 0 6-2-1-2-4 0-6Z"
                fill={coral}
                stroke="none"
              />
              <path d="M102 119h13v3.5h-13Z" fill={navy} stroke-width="1.6" />
            </g>
          )}
          {pose === 'diploma' && (
            <g stroke={line} transform="translate(111 44) rotate(39)">
              <rect
                x="-14"
                y="-4.5"
                width="28"
                height="9"
                rx="4.5"
                fill={paper}
                stroke-width="1.8"
              />
              <ellipse
                cx="-14"
                cy="0"
                rx="2"
                ry="4.5"
                fill={paper}
                stroke-width="1.4"
              />
              <rect
                x="-2"
                y="-5"
                width="4.5"
                height="10"
                fill={coral}
                stroke-width="1.2"
              />
            </g>
          )}
          <g
            fill={shade}
            stroke={line}
            stroke-width="2.2"
            stroke-linejoin="round"
          >
            <g transform={`translate(38 72) rotate(${held.left})`}>
              <g class="duck__arm duck__arm--left">
                <path transform="translate(-38 -72)" d={armL}></path>
              </g>
            </g>
            <g transform={`translate(82 72) rotate(${held.right})`}>
              <g class="duck__arm duck__arm--right">
                <path transform="translate(-82 -72)" d={armR}></path>
              </g>
            </g>
          </g>
          {/* Things held up in front sit over the hands. */}
          {pose === 'read' && (
            <g stroke={line} stroke-linejoin="round">
              <path
                d="M36 99c8-3 16-2 24 2 8-4 16-5 24-2v19c-8-3-16-2-24 2-8-4-16-5-24-2Z"
                fill={coral}
                stroke-width="2"
              />
              <path
                d="M39 97c7-3 14-2 21 2v18c-7-4-14-5-21-2Z"
                fill={paper}
                stroke-width="1.6"
              />
              <path
                d="M60 99c7-4 14-5 21-2v18c-7-3-14-2-21 2Z"
                fill={paper}
                stroke-width="1.6"
              />
              <path
                d="M43 103c4-1.5 9-1.5 13 0M43 108c4-1.5 9-1.5 13 0M64 103c4-1.5 9-1.5 13 0M64 108c4-1.5 9-1.5 13 0"
                fill="none"
                stroke-width="1.2"
                stroke-linecap="round"
                opacity="0.5"
              />
            </g>
          )}
          {pose === 'sketch' && (
            <g stroke={line} stroke-linejoin="round" stroke-linecap="round">
              <rect
                x="29"
                y="88"
                width="30"
                height="34"
                rx="2.5"
                transform="rotate(-10 44 105)"
                fill={paper}
                stroke-width="1.8"
              />
              <path
                d="M36 109l7-9 7 9M38 109v6h10v-6"
                fill="none"
                stroke={coral}
                stroke-width="1.8"
              />
              <path
                d="M71.5 116.3 87.5 92.3 92.5 95.7 76.5 119.7Z"
                fill="#f2c14e"
                stroke-width="1.6"
              />
              <path
                d="M87.5 92.3 93.9 88.2 92.5 95.7Z"
                fill="#f3d9b1"
                stroke-width="1.4"
              />
              <path
                d="M71.5 116.3 76.5 119.7 74.3 123 69.3 119.6Z"
                fill="#f2a7a0"
                stroke-width="1.4"
              />
            </g>
          )}
          {pose === 'ship' && (
            <g stroke={line} stroke-linejoin="round">
              <path d="M46 100l14-21 14 21Z" fill={paper} stroke-width="1.8" />
              <path d="M37 100h46l-8 13H45Z" fill={paper} stroke-width="1.8" />
              <path
                d="M60 79v21"
                fill="none"
                stroke-width="1.2"
                opacity="0.5"
              />
            </g>
          )}
          {pose === 'grow' && (
            <g stroke={line} stroke-linejoin="round">
              <path
                d="M60 99c0-6 0-10 1-15"
                fill="none"
                stroke="#6f9a5b"
                stroke-width="2.2"
                stroke-linecap="round"
              />
              <path
                d="M61 89c-6-6-12-4-13 0 5 3 10 3 13 0Z"
                fill="#9cc27e"
                stroke-width="1.4"
              />
              <path
                d="M61 85c4-7 11-7 13-3-4 4-9 5-13 3Z"
                fill="#9cc27e"
                stroke-width="1.4"
              />
              <path
                d="M48 102h24l-3 17H51Z"
                fill="#d98a5b"
                stroke-width="1.8"
              />
              <path d="M45 97h30v5.5H45Z" fill="#e7a173" stroke-width="1.8" />
            </g>
          )}
          {pose === 'inspect' && (
            <g stroke={line} stroke-linecap="round">
              <path d="M108 97 111 85" stroke={navy} stroke-width="5" />
              <circle
                cx="113"
                cy="76"
                r="10"
                fill="oklch(0.92 0.04 220 / 0.85)"
                stroke-width="2.2"
              />
              <path
                d="M107 73c1-3 4-5 7-5"
                fill="none"
                stroke={paper}
                stroke-width="1.8"
              />
            </g>
          )}
          <g transform="translate(60 80)">
            <g class="duck__head">
              <g transform="translate(-60 -80)">
                <ellipse
                  cx="60"
                  cy="52"
                  rx="35"
                  ry="29"
                  fill={yellow}
                ></ellipse>
                <g clip-path={`url(#${id}-head)`}>
                  <ellipse
                    cx="64"
                    cy="86"
                    rx="42"
                    ry="17"
                    fill={shade}
                  ></ellipse>
                  <ellipse
                    cx="42"
                    cy="34"
                    rx="11"
                    ry="5.5"
                    fill="oklch(0.98 0.04 100)"
                    transform="rotate(-24 42 34)"
                  ></ellipse>
                </g>
                <ellipse
                  cx="60"
                  cy="52"
                  rx="35"
                  ry="29"
                  fill="none"
                  stroke={line}
                  stroke-width="2.4"
                ></ellipse>
                <g class="duck__look">
                  {held.happy ? (
                    <path
                      d="M38 54c2-4 8-4 10 0M72 54c2-4 8-4 10 0"
                      fill="none"
                      stroke="oklch(0.2 0.025 264)"
                      stroke-width="2.6"
                      stroke-linecap="round"
                    />
                  ) : (
                    <g class="duck__eyes">
                      <ellipse
                        cx="43"
                        cy="52"
                        rx="4.2"
                        ry="5.2"
                        fill="oklch(0.2 0.025 264)"
                      />
                      <ellipse
                        cx="77"
                        cy="52"
                        rx="4.2"
                        ry="5.2"
                        fill="oklch(0.2 0.025 264)"
                      />
                      <circle cx="41.7" cy="49.9" r="1.6" fill="#fff" />
                      <circle cx="75.7" cy="49.9" r="1.6" fill="#fff" />
                    </g>
                  )}
                </g>
                <ellipse
                  cx="35"
                  cy="62"
                  rx="5.6"
                  ry="3.2"
                  fill="oklch(0.8 0.1 22 / 0.55)"
                ></ellipse>
                <ellipse
                  cx="85"
                  cy="62"
                  rx="5.6"
                  ry="3.2"
                  fill="oklch(0.8 0.1 22 / 0.55)"
                ></ellipse>
                <path
                  d="M48 58c3-4 21-4 24 0 2 5-5 9-12 9s-14-4-12-9Z"
                  fill={orange}
                  stroke={line}
                  stroke-width="2"
                  stroke-linejoin="round"
                ></path>
                <path
                  d="M51 62c5 2.4 13 2.4 18 0"
                  fill="none"
                  stroke={line}
                  stroke-width="1.6"
                  stroke-linecap="round"
                ></path>
                <g transform="translate(36 28)">
                  <g class="duck__cap">
                    <g transform="translate(-36 -28) rotate(-7 60 24)">
                      <path
                        d={skull}
                        fill="oklch(0.24 0.03 268)"
                        stroke="oklch(0.2 0.025 264)"
                        stroke-width="2"
                        stroke-linejoin="round"
                      ></path>
                      <path
                        d={board}
                        fill={navy}
                        stroke="oklch(0.2 0.025 264)"
                        stroke-width="2"
                        stroke-linejoin="round"
                      ></path>
                      <path
                        d="M35 21.2l24-9"
                        stroke="oklch(0.55 0.04 280)"
                        stroke-width="1.6"
                        stroke-linecap="round"
                      ></path>
                      <g transform="translate(60 21)">
                        <g class="duck__tassel">
                          <g transform="translate(-60 -21)">
                            <path
                              d="M60 21c14-1 24 1 28 3v12"
                              fill="none"
                              stroke={orange}
                              stroke-width="2.4"
                              stroke-linecap="round"
                            ></path>
                            <path
                              d="M85.5 35h5l1.5 8.5h-8Z"
                              fill={orange}
                              stroke={line}
                              stroke-width="1.6"
                              stroke-linejoin="round"
                            ></path>
                          </g>
                        </g>
                      </g>
                      <circle
                        cx="60"
                        cy="21"
                        r="2.6"
                        fill={orange}
                        stroke={line}
                        stroke-width="1.4"
                      ></circle>
                    </g>
                  </g>
                </g>
              </g>
            </g>
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>

<script>
  // One set of listeners for every live duck on the page.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const ducks = () => document.querySelectorAll<SVGSVGElement>('.duck--alive');

  // Replays a one-shot animation class, even if it's still running.
  const replay = (duck: Element, name: string) => {
    duck.classList.remove(name);
    void (duck as SVGElement).getBoundingClientRect();
    duck.classList.add(name);
  };

  for (const duck of ducks()) {
    duck.addEventListener('animationend', (event) => {
      const target = event.target as Element;
      if (target.classList.contains('duck__rig')) {
        duck.classList.remove('duck--hop', 'duck--wave');
      }
      if (target.classList.contains('duck__cap'))
        duck.classList.remove('duck--tip');
    });
    // A tap makes it hop. Mouse users get the wave again on hover.
    duck.addEventListener('pointerdown', () => replay(duck, 'duck--hop'));
    duck.addEventListener('pointerenter', (event) => {
      if (
        event.pointerType === 'mouse' &&
        !duck.classList.contains('duck--hop')
      )
        replay(duck, 'duck--wave');
    });
  }

  // Eyes follow the pointer, a couple of units at most.
  let frame = 0;
  let pointer = { x: 0, y: 0 };
  addEventListener(
    'pointermove',
    (event) => {
      if (still.matches || event.pointerType !== 'mouse') return;
      pointer = { x: event.clientX, y: event.clientY };
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        for (const duck of ducks()) {
          const box = duck.getBoundingClientRect();
          const dx = pointer.x - (box.left + box.width / 2);
          const dy = pointer.y - (box.top + box.height * 0.37);
          const reach = Math.hypot(dx, dy) || 1;
          const pull = Math.min(1, reach / 260);
          duck.style.setProperty('--look-x', `${(dx / reach) * 2.6 * pull}px`);
          duck.style.setProperty('--look-y', `${(dy / reach) * 2 * pull}px`);
        }
      });
    },
    { passive: true },
  );

  // The cap tips when the theme changes, on the landing page and in the docs.
  new MutationObserver(() => {
    for (const duck of ducks()) replay(duck, 'duck--tip');
  }).observe(document.documentElement, { attributeFilter: ['data-theme'] });
</script>

<style>
  .duck {
    display: block;
    flex: none;
    overflow: visible;
  }
  .duck__eyes {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .duck__look {
    transform: translate(var(--look-x, 0), var(--look-y, 0));
    transition: transform 0.25s ease-out;
  }

  @media (prefers-reduced-motion: no-preference) {
    .duck--wave .duck__rig {
      animation: duck-lean 1.9s ease-in-out both;
    }
    .duck--wave .duck__head {
      animation: duck-tilt 1.9s ease-in-out both;
    }
    .duck--wave .duck__arm--right {
      animation: duck-wave 1.9s ease-in-out both;
    }
    .duck--wave .duck__arm--left {
      animation: duck-sway 1.9s ease-in-out both;
    }
    .duck--wave .duck__tassel {
      animation: duck-tassel 1.9s ease-in-out both;
    }
    .duck--alive .duck__eyes {
      animation: duck-blink 3.4s linear 0.4s both;
    }
    .duck--hop .duck__rig {
      animation: duck-hop 0.75s ease-in-out both;
    }
    .duck--hop .duck__arm--right {
      animation: duck-flap-right 0.75s ease-in-out both;
    }
    .duck--hop .duck__arm--left {
      animation: duck-flap-left 0.75s ease-in-out both;
    }
    .duck--hop .duck__tassel {
      animation: duck-tassel 0.75s ease-in-out both;
    }
    .duck--tip .duck__cap {
      animation: duck-tip 0.9s ease-in-out both;
    }
  }

  /* The wave: a small dip, the hand up beside the face, three waves, and a settle. */
  @keyframes duck-wave {
    0% {
      transform: rotate(0);
    }
    10% {
      transform: rotate(10deg);
    }
    26% {
      transform: rotate(-124deg);
    }
    36% {
      transform: rotate(-96deg);
    }
    46% {
      transform: rotate(-120deg);
    }
    56% {
      transform: rotate(-96deg);
    }
    66% {
      transform: rotate(-116deg);
    }
    84% {
      transform: rotate(6deg);
    }
    92% {
      transform: rotate(-3deg);
    }
    100% {
      transform: rotate(0);
    }
  }
  @keyframes duck-sway {
    0%,
    100% {
      transform: rotate(0);
    }
    26% {
      transform: rotate(7deg);
    }
    56% {
      transform: rotate(3deg);
    }
    84% {
      transform: rotate(-3deg);
    }
  }
  @keyframes duck-lean {
    0% {
      transform: none;
    }
    10% {
      transform: scale(1.03, 0.96);
    }
    26% {
      transform: rotate(-3deg) scale(0.99, 1.02);
    }
    66% {
      transform: rotate(-3deg);
    }
    86% {
      transform: rotate(1deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes duck-tilt {
    0%,
    10% {
      transform: none;
    }
    28% {
      transform: rotate(7deg);
    }
    66% {
      transform: rotate(6deg);
    }
    86% {
      transform: rotate(-1.5deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes duck-tassel {
    0%,
    100% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(12deg);
    }
    55% {
      transform: rotate(-6deg);
    }
    78% {
      transform: rotate(3deg);
    }
  }
  @keyframes duck-blink {
    0%,
    48%,
    52%,
    80%,
    84%,
    100% {
      transform: scaleY(1);
    }
    50%,
    82% {
      transform: scaleY(0.1);
    }
  }
  /* The hop: squash, jump with a stretch, land with a squash, settle. */
  @keyframes duck-hop {
    0% {
      transform: none;
    }
    18% {
      transform: scale(1.08, 0.88);
    }
    45% {
      transform: translateY(-16px) scale(0.95, 1.07);
    }
    70% {
      transform: scale(1.06, 0.92);
    }
    85% {
      transform: scale(0.98, 1.02);
    }
    100% {
      transform: none;
    }
  }
  @keyframes duck-flap-right {
    0%,
    100% {
      transform: rotate(0);
    }
    18% {
      transform: rotate(8deg);
    }
    45% {
      transform: rotate(-70deg);
    }
    70% {
      transform: rotate(-10deg);
    }
  }
