---
// The SWE OS duck: a die-cut sticker of a duck in a graduation cap. Decorative everywhere it
// appears (the name next to it, or the page around it, says what it is). With `alive`, it waves
// and blinks once on load and again on hover, and stays still under reduced motion.
interface Props {
  size?: number;
  class?: string;
  alive?: boolean;
}
const { size = 32, class: className, alive = false } = Astro.props;
// A page can show several ducks, so each one gets its own ids for its clip paths.
const id = `duck-${Math.random().toString(36).slice(2, 8)}`;
const line = 'oklch(0.3 0.04 55)';
const body = 'M60 74c16 0 28 11 28 26s-12 25-28 25-28-10-28-25 12-26 28-26Z';
const armL = 'M37 70c-10 4-14 17-15 28-1 8 1 13 6 13s6-5 6-12c0-9 3-17 8-22Z';
const armR = 'M83 70c10 4 14 17 15 28 1 8-1 13-6 13s-6-5-6-12c0-9-3-17-8-22Z';
const board = 'M31 21l29-11 29 11-29 11Z';
const skull = 'M42 25c2 8 34 8 36 0v6c-3 8-33 8-36 0Z';
---

<svg
  class:list={['duck', className, { 'duck--alive': alive }]}
  width={size}
  height={Math.round((size * 140) / 104)}
  viewBox="8 0 104 140"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={`${id}-body`}>
      <path d={body}></path>
    </clipPath>
    <clipPath id={`${id}-head`}>
      <ellipse cx="60" cy="52" rx="35" ry="29"></ellipse>
    </clipPath>
  </defs>
  <g
    class="duck__sticker"
    fill="#fffdf6"
    stroke="#fffdf6"
    stroke-width="9"
    stroke-linejoin="round"
  >
    <path d={body}></path>
    <path d={armL}></path>
    <path d={armR}></path>
    <ellipse cx="60" cy="52" rx="35" ry="29"></ellipse>
    <ellipse cx="47" cy="124" rx="8.5" ry="5"></ellipse>
    <ellipse cx="73" cy="124" rx="8.5" ry="5"></ellipse>
    <g transform="rotate(-7 60 24)">
      <path d={board}></path>
      <path d={skull}></path>
      <path d="M60 21c14-1 24 1 28 3v14" fill="none"></path>
    </g>
  </g>
  <g fill="oklch(0.76 0.15 50)" stroke={line} stroke-width="2">
    <ellipse cx="47" cy="124" rx="8" ry="4.6"></ellipse>
    <ellipse cx="73" cy="124" rx="8" ry="4.6"></ellipse>
  </g>
  <path d={body} fill="oklch(0.93 0.1 97)"></path>
  <g clip-path={`url(#${id}-body)`}>
    <ellipse
      cx="74"
      cy="122"
      rx="34"
      ry="18"
      fill="oklch(0.87 0.115 88)"
    ></ellipse>
  </g>
  <path d={body} fill="none" stroke={line} stroke-width="2.4"></path>
  <g
    fill="oklch(0.88 0.115 89)"
    stroke={line}
    stroke-width="2.2"
    stroke-linejoin="round"
  >
    <path class="duck__arm duck__arm--left" d={armL}></path>
    <path class="duck__arm duck__arm--right" d={armR}></path>
  </g>
  <ellipse cx="60" cy="52" rx="35" ry="29" fill="oklch(0.93 0.1 97)"></ellipse>
  <g clip-path={`url(#${id}-head)`}>
    <ellipse
      cx="64"
      cy="86"
      rx="42"
      ry="17"
      fill="oklch(0.87 0.115 88)"
    ></ellipse>
    <ellipse
      cx="42"
      cy="34"
      rx="11"
      ry="5.5"
      fill="oklch(0.98 0.04 100)"
      transform="rotate(-24 42 34)"
    ></ellipse>
  </g>
  <ellipse
    cx="60"
    cy="52"
    rx="35"
    ry="29"
    fill="none"
    stroke={line}
    stroke-width="2.4"
  ></ellipse>
  <g class="duck__eyes">
    <ellipse
      cx="43"
      cy="52"
      rx="4.2"
      ry="5.2"
      fill="oklch(0.2 0.025 264)"
    ></ellipse>
    <ellipse
      cx="77"
      cy="52"
      rx="4.2"
      ry="5.2"
      fill="oklch(0.2 0.025 264)"
    ></ellipse>
    <circle cx="41.7" cy="49.9" r="1.6" fill="#fff"></circle>
    <circle cx="75.7" cy="49.9" r="1.6" fill="#fff"></circle>
  </g>
  <ellipse
    cx="35"
    cy="62"
    rx="5.6"
    ry="3.2"
    fill="oklch(0.8 0.1 22 / 0.55)"
  ></ellipse>
  <ellipse
    cx="85"
    cy="62"
    rx="5.6"
    ry="3.2"
    fill="oklch(0.8 0.1 22 / 0.55)"
  ></ellipse>
  <path
    d="M48 58c3-4 21-4 24 0 2 5-5 9-12 9s-14-4-12-9Z"
    fill="oklch(0.76 0.15 50)"
    stroke={line}
    stroke-width="2"
    stroke-linejoin="round"
  ></path>
  <path
    d="M51 62c5 2.4 13 2.4 18 0"
    fill="none"
    stroke={line}
    stroke-width="1.6"
    stroke-linecap="round"
  ></path>
  <g transform="rotate(-7 60 24)">
    <path
      d={skull}
      fill="oklch(0.24 0.03 268)"
      stroke="oklch(0.2 0.025 264)"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
    <path
      d={board}
      fill="oklch(0.27 0.035 268)"
      stroke="oklch(0.2 0.025 264)"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
    <path
      d="M35 21.2l24-9"
      stroke="oklch(0.55 0.04 280)"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <g class="duck__tassel">
      <path
        d="M60 21c14-1 24 1 28 3v12"
        fill="none"
        stroke="oklch(0.76 0.15 50)"
        stroke-width="2.4"
        stroke-linecap="round"
      ></path>
      <path
        d="M85.5 35h5l1.5 8.5h-8Z"
        fill="oklch(0.76 0.15 50)"
        stroke={line}
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </g>
    <circle
      cx="60"
      cy="21"
      r="2.6"
      fill="oklch(0.76 0.15 50)"
      stroke={line}
      stroke-width="1.4"
    ></circle>
  </g>
</svg>

<style>
  .duck {
    display: block;
    flex: none;
    overflow: visible;
    filter: drop-shadow(0 2px 2px rgb(18 21 31 / 0.18));
  }
  .duck__arm,
  .duck__tassel,
  .duck__eyes {
    transform-box: fill-box;
  }
  .duck__arm--left {
    transform-origin: 80% 4%;
  }
  .duck__arm--right {
    transform-origin: 20% 4%;
  }
  .duck__tassel {
    transform-origin: 0% 0%;
  }
  .duck__eyes {
    transform-origin: 50% 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .duck--alive .duck__arm--right {
      animation: duck-wave 1.6s ease-in-out 0.3s 1 both;
    }
    .duck--alive .duck__arm--left {
      animation: duck-swing 1.6s ease-in-out 0.3s 1 both;
    }
    .duck--alive .duck__tassel {
      animation: duck-tassel 2.2s ease-in-out 0.2s 1 both;
    }
    .duck--alive .duck__eyes {
      animation: duck-blink 3.2s linear 0.6s 1 both;
    }
    .duck--alive:hover .duck__arm--right {
      animation-name: duck-wave-again;
    }
    .duck--alive:hover .duck__tassel {
      animation-name: duck-tassel-again;
    }
  }
  @keyframes duck-wave {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-38deg);
    }
    45% {
      transform: rotate(-22deg);
    }
    65% {
      transform: rotate(-38deg);
    }
  }
  @keyframes duck-wave-again {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-38deg);
    }
    45% {
      transform: rotate(-22deg);
    }
    65% {
      transform: rotate(-38deg);
    }
  }
  @keyframes duck-swing {
    0%,
    100% {
      transform: rotate(0);
    }
    40% {
      transform: rotate(6deg);
    }
    70% {
      transform: rotate(-3deg);
    }
  }
  @keyframes duck-tassel {
    0%,
    100% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(9deg);
    }
    60% {
      transform: rotate(-5deg);
    }
    80% {
      transform: rotate(2deg);
    }
  }
  @keyframes duck-tassel-again {
    0%,
    100% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(9deg);
    }
    60% {
      transform: rotate(-5deg);
    }
    80% {
      transform: rotate(2deg);
    }
  }
  @keyframes duck-blink {
    0%,
    4%,
    8%,
    70%,
    74%,
    100% {
      transform: scaleY(1);
    }
    6%,
    72% {
      transform: scaleY(0.12);
    }
  }
</style>
